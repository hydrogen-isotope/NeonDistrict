OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "SKVOT Lesson / Low-Poly Futuristic Building" by jsandorblendercourse (@jsandorblendercourse), CC BY 4.0 -- https://sketchfab.com/3d-models/skvot-lesson-low-poly-futuristic-building-38440b9950304dfd99f92d5eb4f04d8c
NAME NeonDistrict_sf220_Blue_Neon_Light
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0.193652 0.713729 0.903545 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.5
# No glow: the source carried an emissive factor with no (or an all-black) emissive map.
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
