OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "HoloBoard" by TooManyDemons (@toomanydemons), CC BY 4.0 -- https://sketchfab.com/3d-models/holoboard-0644f1b2450543e2a96d5eae496798b6
NAME NeonDistrict_sf43_MAT_Holoboard
SHADER standard
# Opaque, not blended: its alpha is 1 almost everywhere, and blended emitters are invisible to GI.
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 0.327553
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.1 = about 3,330 cd/m2:
# hologram screen (cyan-blue radar / HUD / bar-chart art on a blue grid, mean luminance about 0.6) and the two bottom control panels (blue keyboard and port glyphs); emissive factor 1.0 x an emissive map that is bright over the whole quad (white up to 1.0), so left at 1.0 it would be a 30,000 cd/m2 light wall. About 0.10 gives a real-life LED-sign level of about 2,000 cd/m2 mean with white elements near 3,000. The material is alpha BLEND (0.33): if the engine multiplies emission by alpha the screen will look dim and the strength can go up toward 0.2-0.3, if it adds emission after blend keep 0.10.
PARAM emissiveFactor 0.1 0.1 0.1
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/MAT_Holoboard_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/MAT_Holoboard_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/MAT_Holoboard_normal.jpg} uv0 normal
TEX emissive {path:Textures/NeonDistrict/MAT_Holoboard_emissive.jpg} uv0 sRGB
