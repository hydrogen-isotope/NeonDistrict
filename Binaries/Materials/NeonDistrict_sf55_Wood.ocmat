OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Fisher boat" by Batuhan13 (@Batuhan13), CC BY 4.0 -- https://sketchfab.com/3d-models/fisher-boat-385b039e95754dca8d8c045ed0c515cf
NAME NeonDistrict_sf55_Wood
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/Wood_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/Wood_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/Wood_normal.png} uv0 normal
