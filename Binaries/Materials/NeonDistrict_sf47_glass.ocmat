OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Parking garage [FREE DOWNLOAD]" by Idmenthal (@idmental.id), CC BY 4.0 -- https://sketchfab.com/3d-models/parking-garage-free-download-5310b7d77b70427d936ec4253fff679c
NAME NeonDistrict_sf47_glass
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0.439483
PARAM roughnessFactor 0.201787
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.15 = about 5,000 cd/m2:
# the 20 neon tube strips (cyan 0.43, 0.89, 1.0; the file ships emissive strength 10 with clearcoat 1.0, far too hot). The material is named glass but it is opaque tube geometry, not a window: do not make it transmissive..
PARAM emissiveFactor 0.06421 0.1335 0.15
# THE LIGHT IT CASTS: every draw with this material is a small sphere light (at most 32 lit per
# frame); 1 multiplies what its own glow over its size physically casts.
PARAM lightIntensity 1
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
