OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Cyberpunk car" by 4d_Bob (@3d_Bob), CC BY 4.0 -- https://sketchfab.com/3d-models/cyberpunk-car-b4301ff99d214d16a7a43708a5866bf0
NAME NeonDistrict_sf37_cb_car
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.1 = about 3,330 cd/m2:
# front light slashes: two thin slanted pale-blue strips near the nose sides (headlight / DRL signature, the blue glint at the nose in the side view). Optionally add two real spot lights at the nose if the car should light the street; otherwise emission only..
PARAM emissiveFactor 0.1 0.1 0.1
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf37_cb_car_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf37_cb_car_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf37_cb_car_normal.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/sf37_cb_car_metallicRoughness.png} uv0 linear
TEX emissive {path:Textures/NeonDistrict/sf37_cb_car_emissive.png} uv0 sRGB
