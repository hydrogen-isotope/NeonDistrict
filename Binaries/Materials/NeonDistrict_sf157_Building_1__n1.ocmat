OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Old Japanese Store | Lowpoly" by Frid.blend (@Fridqeir), CC BY 4.0 -- https://sketchfab.com/3d-models/old-japanese-store-lowpoly-baa1a12ed0984143adde52b5e165e288
NAME NeonDistrict_sf157_Building_1__n1
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.92
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.03 = about 1,000 cd/m2:
# night windows: rooms painted into the facade texture, about 1,000 cd/m2 at a full-white texel.
PARAM emissiveFactor 0.03 0.03 0.03
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf157_Building_1_b.png} uv0 sRGB
TEX emissive {path:Textures/NeonDistrict/sf157_Building_1_e1.png} uv0 sRGB
