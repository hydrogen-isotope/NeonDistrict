OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Vintage Chinese Neon Pedestrian Signals" by Signalrenders, CC BY 4.0 -- https://sketchfab.com/3d-models/vintage-chinese-neon-pedestrian-signals-d733eb9a02774dbd94a04738596edf10
NAME NeonDistrict_sf15_Neon_red
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 0.0364471 0.0364471 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.804041
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.15 = about 5,000 cd/m2:
# red neon tubes of the 等待 (wait) characters: signal_wait and signal_both.
PARAM emissiveFactor 0.15 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
