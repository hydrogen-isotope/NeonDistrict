OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Cyberpunk skyscrapers set" by Artemis (@Artemis26), CC BY 4.0 -- https://sketchfab.com/3d-models/cyberpunk-skyscrapers-set-9acbf256afe84283baacf3ee617d2aaf
NAME NeonDistrict_sf40_Material_002
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
# Not metal: its metal/rough map marks the panes metal 1 / rough 0, a black mirror.
PARAM metallicFactor 0
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.15 = about 5,000 cd/m2:
# red neon strip columns (dashed vertical strips on tower_06/07 and rows on the mid towers); Object_11 only, 2.5k tris, about 7 m2 at scale 1. Source has emissive factor (0.76, 0.016, 0) with KHR_materials_emissive_strength 5.84 (about 4.4 in glTF units), far too hot taken literally.
PARAM emissiveFactor 0.15 0.003239 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
