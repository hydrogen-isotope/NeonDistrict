OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Procedural Hong Kong building" by uday (udayjeet), CC BY 4.0 -- https://sketchfab.com/3d-models/procedural-hong-kong-building-528a732e84c44fd49c4726f341014a23
NAME NeonDistrict_glass_001
SHADER standard
BLEND translucent
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0.877424 0.913744 0.92879 0.12
# Not metal: its metal/rough map marks the panes metal 1 / rough 0, a black mirror.
PARAM metallicFactor 0
PARAM roughnessFactor 0.05
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
# Clear glass: transmission takes away the diffuse lobe a pane does not have (a milky veil that
# carried all of the pane's own lighting noise); alpha and the cast shadow stay about the same.
PARAM transmission 0.9
PARAM uvTiling 200
