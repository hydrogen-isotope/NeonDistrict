OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Japanese light signage" by Sousinho, CC BY 4.0 -- https://sketchfab.com/3d-models/japanese-light-signage-5bc2755daf934419a176604163ffbd20
NAME NeonDistrict_sf10_square_sign
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.1 = about 3,330 cd/m2:
# paper lightbox panels on 3 faces (warm parchment, linear ~0.53,0.48,0.34); dark brush characters, frame, arms and back stay unlit.
PARAM emissiveFactor 0.1 0.1 0.1
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf10_Image_0.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf10_Image_1.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf10_Image_3.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/sf10_Image_1.png} uv0 linear
TEX emissive {path:Textures/NeonDistrict/sf10_Image_2.png} uv0 sRGB
