OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Japan post box" by exiS7-Gs, CC BY 4.0 -- https://sketchfab.com/3d-models/japan-post-box-ed30f71494e44801bb18cb5aeddcddf6
NAME NeonDistrict_sf26_GLASS
SHADER standard
# Opaque, not blended: its alpha is 1 almost everywhere, and blended emitters are invisible to GI.
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
# Not metal: its metal/rough map marks the panes metal 1 / rough 0, a black mirror.
PARAM metallicFactor 0
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0 = about 0 cd/m2:
# slot flap glass: emissive map is black, nothing to glow; set 0.
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf26_GLASS_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf26_GLASS_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf26_GLASS_normal.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/sf26_GLASS_metallicRoughness.png} uv0 linear
TEX emissive {path:Textures/NeonDistrict/sf26_GLASS_emissive.png} uv0 sRGB
