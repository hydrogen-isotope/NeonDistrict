OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Cyberpunk Building" by igor.tesV (@igor.tesV), CC BY 4.0 -- https://sketchfab.com/3d-models/cyberpunk-building-e79154e588bd4a6c84fa07e9a53f3ff9
NAME NeonDistrict_sf89_THREE
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/THREE_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/THREE_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/THREE_normal.png} uv0 normal
