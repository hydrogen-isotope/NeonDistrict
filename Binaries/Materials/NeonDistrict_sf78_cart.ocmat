OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Trash" by Guy in a Poncho (@ponchoguy), CC BY 4.0 -- https://sketchfab.com/3d-models/trash-555fd7fe9f164802a0ff194c0559075b
NAME NeonDistrict_sf78_cart
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf78_cart_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf78_cart_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf78_cart_normal.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/sf78_cart_metallicRoughness.png} uv0 linear
