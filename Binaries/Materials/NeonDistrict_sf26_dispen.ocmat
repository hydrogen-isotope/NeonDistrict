OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Japan post box" by exiS7-Gs, CC BY 4.0 -- https://sketchfab.com/3d-models/japan-post-box-ed30f71494e44801bb18cb5aeddcddf6
NAME NeonDistrict_sf26_dispen
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0 = about 0 cd/m2:
# slot frames: authored emissive map is a faint grey (max 0.23, tiny UV island), effectively none; set 0.
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf26_dispen_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf26_dispen_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf26_dispen_normal.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/sf26_dispen_metallicRoughness.png} uv0 linear
TEX emissive {path:Textures/NeonDistrict/sf26_dispen_emissive.png} uv0 sRGB
