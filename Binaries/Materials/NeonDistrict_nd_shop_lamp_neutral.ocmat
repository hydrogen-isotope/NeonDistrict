OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: Poly Haven (CC0) or generated for this level
NAME NeonDistrict_nd_shop_lamp_neutral
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0.953238 0.953238 0.953238 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.5
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.25 = about 8,330 cd/m2:
# shop ceiling lamp, 4000 K: about 8,300 cd/m2, and a real light.
PARAM emissiveFactor 0.25 0.225 0.195
# THE LIGHT IT CASTS: every draw with this material is a small sphere light (at most 32 lit per
# frame); 0.13 multiplies what its own glow over its size physically casts.
PARAM lightIntensity 0.13
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
