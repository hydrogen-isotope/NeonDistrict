OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Asia Building" by Solarliu (@jacky15621419), CC BY 4.0 -- https://sketchfab.com/3d-models/asia-building-a3f45195b01f48ff9f687d3ceac52b82
NAME NeonDistrict_sf98_concrete_02
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.952432
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/concrete_02_baseColor.jpg} uv0 sRGB
