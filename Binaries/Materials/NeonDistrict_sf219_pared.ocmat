OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Low Cyberpunk Building" by JackSpector_Ink (@Sp3ctor_Ink), CC BY 4.0 -- https://sketchfab.com/3d-models/low-cyberpunk-building-c344904c020742d78a6967ce04faae95
NAME NeonDistrict_sf219_pared
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/pared_baseColor.jpg} uv0 sRGB
