OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Night market stall" by Allen Tseng (@alen60303), CC BY 4.0 -- https://sketchfab.com/3d-models/night-market-stall-ffaabf87bb024b48b240909632e0b524
NAME NeonDistrict_sf60_plus
SHADER standard
BLEND masked 0.264151
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.6
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.15 = about 5,000 cd/m2:
# neon glyph sign (white-cyan brush strokes on black in the emissive map, factor 0.3, alpha MASK 0.26): a 0.675 x 0.44 m double-sided plane hanging inside the front opening at z 2.5-2.9 m; the base colour has a saturated blue halo around the glyph. Treat as a neon tube..
PARAM emissiveFactor 0.15 0.15 0.15
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/plus_baseColor.png} uv0 sRGB
TEX emissive {path:Textures/NeonDistrict/plus_emissive.png} uv0 sRGB
