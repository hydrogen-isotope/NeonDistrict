OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Neon Letters" by danny_p3d, CC BY 4.0 -- https://sketchfab.com/3d-models/neon-letters-a88035b37ba4498b8d7fe9cfbc0dccc8
NAME NeonDistrict_sf13_lambert4SG
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.15 = about 5,000 cd/m2:
# neon tube (all 26 letters). The authored emissive map is pure black (max 0) although emissiveFactor=1, so as shipped nothing glows: the build must give each sign its own emissive tint.
PARAM emissiveFactor 0.15 0.15 0.15
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/Image_0-2.jpg} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/Image_1-3.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/Image_3.jpg} uv0 normal
TEX emissive {path:Textures/NeonDistrict/Image_2-2.jpg} uv0 sRGB
