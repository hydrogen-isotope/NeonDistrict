OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Futuristic building" by Oleksandr Zymohliad (@oleksandr_zymohliad), CC BY 4.0 -- https://sketchfab.com/3d-models/futuristic-building-8cb99bb8e540450eb11c2bddeac1343a
NAME NeonDistrict_sf90_Blue_light
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 0.6
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.03 = about 1,000 cd/m2:
# named blue but emissive RED (1,0.02,0.02): glowing tubes in the tall pipe stacks, the mast-tip cap and two of the four foot beacons.
PARAM emissiveFactor 0.03 0.0005461 0.0005461
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
