OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Cyberpunk Temple" by Chiel_Paassen (@Chiel_Paassen), CC BY 4.0 -- https://sketchfab.com/3d-models/cyberpunk-temple-1f85def3b1604a85b9b0319fc083109f
NAME NeonDistrict_sf158_lambert1
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.08 = about 2,670 cd/m2:
# emissive map: purple grid windows (tall slats, window box), purple sign panel, teal sign with Chinese-style glyphs, thin teal edge light lines; everything else black.
PARAM emissiveFactor 0.08 0.08 0.08
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf158_lambert1_baseColor_db.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/lambert1_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/lambert1_normal.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/lambert1_metallicRoughness.png} uv0 linear
TEX emissive {path:Textures/NeonDistrict/lambert1_emissive.jpg} uv0 sRGB
