OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Japanese Shop" by local.yany (@local.yany), CC BY 4.0 -- https://sketchfab.com/3d-models/japanese-shop-2e6b142ef11e4ab0a6c32e2af8ec828b
NAME NeonDistrict_sf117_XI_JT_FirstFlr_2_mat1
SHADER standard
# Cut-out, not blended: the alpha is a mask (windows, laundry, grilles); blending sorts badly and
# is invisible to GI.
BLEND masked 0.5
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.957705
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf117_XI_JT_FirstFlr_2_mat1_baseColor.png} uv0 sRGB
