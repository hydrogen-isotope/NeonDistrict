OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Neon Ramen Soup Sign" by @blue.blender.print (arobaco), CC BY 4.0 -- https://sketchfab.com/3d-models/neon-ramen-soup-sign-db7b6dab6fae4fc3a6894e5326609ab9
NAME NeonDistrict_sf09_Ramen_soup_neon
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.15 = about 5,000 cd/m2:
# neon lettering ラーメンスープ: chartreuse/yellow-green strokes (linear ~0.70,0.78,0.21) with dark rust flecks, both faces; panel and pins are black in the emission map.
PARAM emissiveFactor 0.15 0.15 0.15
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/Image_0-1.jpg} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/Image_1-2.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/Image_3-2.png} uv0 normal
TEX emissive {path:Textures/NeonDistrict/Image_2-1.jpg} uv0 sRGB
