OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Fisher boat" by Batuhan13 (@Batuhan13), CC BY 4.0 -- https://sketchfab.com/3d-models/fisher-boat-385b039e95754dca8d8c045ed0c515cf
NAME NeonDistrict_sf55_RedLight
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0.903545 0.11174 0 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.956928
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.1 = about 3,330 cd/m2:
# red navigation lamp above the wheelhouse roof front (emissive factor (1, 0.08, 0)); sits at -X = starboard, should be port. Optional: a small red / green point light (radius 3 m) added engine side is enough, nothing is cast from the asset..
PARAM emissiveFactor 0.1 0.008055 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX normal {path:Textures/NeonDistrict/RedLight_normal.png} uv0 normal
