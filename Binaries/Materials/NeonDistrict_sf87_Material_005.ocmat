OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "sci-fi building concept" by David06 (@David06), CC BY 4.0 -- https://sketchfab.com/3d-models/sci-fi-building-concept-ef51819f82974cf7805659058d5b4f59
NAME NeonDistrict_sf87_Material_005
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.03 = about 1,000 cd/m2:
# cyan (0.11,0.83,1.0) glowing core tube (Object_16) and dome light (Object_34).
PARAM emissiveFactor 0.003444 0.02497 0.03
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
