OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "modern tower office apartment house home" by zigurat architecture studio (@ziguratarchitecturestudio), CC BY 4.0 -- https://sketchfab.com/3d-models/modern-tower-office-apartment-house-home-4480869188b64658aa8c69ed31a730df
NAME NeonDistrict_sf95_21___Default
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.892971
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/22_-_Default_diffuse.jpg} uv0 sRGB
