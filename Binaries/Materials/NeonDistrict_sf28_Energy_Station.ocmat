OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Energy Station [Street Assets Vol. 03]" by Alt (@whisper.alt), CC BY 4.0 -- https://sketchfab.com/3d-models/energy-station-street-assets-vol-03-99058ed37c0f47eeb70aa07d62b4b1a8
NAME NeonDistrict_sf28_Energy_Station
SHADER standard
# Opaque, not blended: its alpha is 1 almost everywhere, and blended emitters are invisible to GI.
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.15 = about 5,000 cd/m2:
# warm-white canopy light strip (brightest texels, top of the emissive atlas) - a real lamp, but it is the same shared material as the sign, so do not let the material cast light; add 2 explicit warm lights under the canopy (z about 2.85 m at scale 1.3) instead.
PARAM emissiveFactor 0.15 0.15 0.15
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf28_Energy_Station_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf28_Energy_Station_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf28_Energy_Station_normal.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/sf28_Energy_Station_metallicRoughness.png} uv0 linear
TEX emissive {path:Textures/NeonDistrict/sf28_Energy_Station_emissive.png} uv0 sRGB
