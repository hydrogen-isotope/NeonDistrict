OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Chinese Food Stall in London" by Pukka Films (@pukkafilms), CC BY 4.0 -- https://sketchfab.com/3d-models/chinese-food-stall-in-london-4c860ac992c74547b3dbcb802b52ea98
NAME NeonDistrict_sf24_FS_Roof
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0 = about 0 cd/m2:
# same: emissive factor 1.0 with an all-black emissive map on the black canopy; must not glow.
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/Image_48-1.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/Image_49-1.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/Image_51.png} uv0 normal
TEX emissive {path:Textures/NeonDistrict/Image_19-1.png} uv0 sRGB
