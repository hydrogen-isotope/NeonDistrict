OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "LCT 3000 '95 - Low poly model" by Daniel Zhabotinsky (@DanielZhabotinsky), CC BY 4.0 -- https://sketchfab.com/3d-models/lct-3000-95-low-poly-model-663a0953c038434a918cb85725c88ffa
NAME NeonDistrict_sf20_UCB_BOTTOM
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/Image_3-1.jpg} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/Image_4-2.png} uv0 linear
TEX occlusion {path:Textures/NeonDistrict/Image_4-2.png} uv0 linear
