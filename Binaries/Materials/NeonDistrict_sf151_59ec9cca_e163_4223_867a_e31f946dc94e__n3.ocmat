OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Grey Japanease Apartment" by Kasuga𓅂 (@kasuga), CC BY 4.0 -- https://sketchfab.com/3d-models/grey-japanease-apartment-8589efeb25284d709934497e02a25421
NAME NeonDistrict_sf151_59ec9cca_e163_4223_867a_e31f946dc94e__n3
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.900025
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.03 = about 1,000 cd/m2:
# night windows: rooms painted into the facade texture, about 1,000 cd/m2 at a full-white texel.
PARAM emissiveFactor 0.03 0.03 0.03
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf151_59ec9cca_e163_4223_867a_e31f946dc94e_b.png} uv0 sRGB
TEX emissive {path:Textures/NeonDistrict/sf151_59ec9cca_e163_4223_867a_e31f946dc94e_e3.png} uv0 sRGB
