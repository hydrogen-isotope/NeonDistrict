OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "ALPHA TOWER" by Portal.Studio (@Portal.Studio), CC BY 4.0 -- https://sketchfab.com/3d-models/alpha-tower-4419eca89c2a43bd9a9f7d662f6b6918
NAME NeonDistrict_sf165_MAT_Metal_2
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf165_MAT_Metal_2_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf165_MAT_Metal_2_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf165_MAT_Metal_2_normal.png} uv0 normal
