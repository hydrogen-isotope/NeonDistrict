OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Japan post box" by exiS7-Gs, CC BY 4.0 -- https://sketchfab.com/3d-models/japan-post-box-ed30f71494e44801bb18cb5aeddcddf6
NAME NeonDistrict_sf26_text_logo
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf26_text_logo_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf26_text_logo_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf26_text_logo_normal.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/sf26_text_logo_metallicRoughness.png} uv0 linear
