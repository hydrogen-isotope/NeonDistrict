OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Rusted corrugated panels" by sousinho, CC BY 4.0 -- https://sketchfab.com/3d-models/rusted-corrugated-panels-ea06568a9e304ecc806cb7cb0552e269
NAME NeonDistrict_sf30_corrugated_sheet_1
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/corrugated_sheet_1_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/corrugated_sheet_1_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/corrugated_sheet_1_normal.png} uv0 normal
