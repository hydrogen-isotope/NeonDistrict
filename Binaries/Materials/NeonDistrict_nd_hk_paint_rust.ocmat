OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Procedural Hong Kong building" by uday (udayjeet), CC BY 4.0 -- https://sketchfab.com/3d-models/procedural-hong-kong-building-528a732e84c44fd49c4726f341014a23
NAME NeonDistrict_nd_hk_paint_rust
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.03 = about 1,000 cd/m2:
# HK tenement shop signs (repainted walls), about 1,000 cd/m2 at a full-white texel.
PARAM emissiveFactor 0.03 0.03 0.03
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/paint_rust.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/Material_Metallic_png-Material_Roughness_png.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/Material_Normal_OpenGL.png} uv0 normal
TEX emissive {path:Textures/NeonDistrict/Material_Emissive.png} uv0 sRGB
