OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: Poly Haven (CC0) or generated for this level
NAME NeonDistrict_nd_sign_board_04
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.35
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.1 = about 3,330 cd/m2:
# billboard screen, about 3,300 cd/m2 at a full-white texel.
PARAM emissiveFactor 0.1 0.1 0.1
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/board_04.png} uv0 sRGB
TEX emissive {path:Textures/NeonDistrict/board_04.png} uv0 sRGB
