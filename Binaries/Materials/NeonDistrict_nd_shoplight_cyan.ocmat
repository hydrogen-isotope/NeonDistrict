OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: Poly Haven (CC0) or generated for this level
NAME NeonDistrict_nd_shoplight_cyan
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0.659353 0.850335 0.893207 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.35
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.22 = about 7,330 cd/m2:
# neon shopfront tube, about 7,300 cd/m2.
PARAM emissiveFactor 0.022 0.198 0.22
# THE LIGHT IT CASTS: every draw with this material is a small sphere light (at most 32 lit per
# frame); 0.358 multiplies what its own glow over its size physically casts.
PARAM lightIntensity 0.358
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
