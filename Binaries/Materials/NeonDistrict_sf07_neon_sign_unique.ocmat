OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Game Ready Japanese Small Vertical Neon Sign" by Alex Bes (alexbescg), CC BY 4.0 -- https://sketchfab.com/3d-models/game-ready-japanese-small-vertical-neon-sign-5849c107ecb7472bb1eef028f5b97f0d
NAME NeonDistrict_sf07_neon_sign_unique
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0 = about 0 cd/m2:
# emission map (orange dot-matrix LED text and coloured dash LEDs) is assigned but maps to NO face of the 512-tri body mesh (checked by UV-bbox sampling); leave non-emissive.
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/Image_0.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/Image_1.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/Image_3.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/Image_1.png} uv0 linear
TEX emissive {path:Textures/NeonDistrict/Image_2.png} uv0 sRGB
