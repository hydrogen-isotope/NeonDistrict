OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Monorail" by iedalton (@iedalton), CC BY 4.0 -- https://sketchfab.com/3d-models/monorail-f56a6e034cf04e65bba860246ab9aa1e
NAME NeonDistrict_sf64_Light
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0.868707 0.903545 0.315892 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.835902
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.4 = about 13,330 cd/m2:
# headlights.
PARAM emissiveFactor 0.4 0.4 0.4
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
