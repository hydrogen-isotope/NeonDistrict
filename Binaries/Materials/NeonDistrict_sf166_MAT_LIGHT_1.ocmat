OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "BETA TOWER" by Portal.Studio (@Portal.Studio), CC BY 4.0 -- https://sketchfab.com/3d-models/beta-tower-bd1c83f306c94582ae988cb69e404cb8
NAME NeonDistrict_sf166_MAT_LIGHT_1
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0 0 0 1
PARAM metallicFactor 0
PARAM roughnessFactor 0
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.03 = about 1,000 cd/m2:
# small inner box whose orange glow shows only through gaps in the greebles (seam lines).
PARAM emissiveFactor 0.03 0.03 0.03
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX emissive {path:Textures/NeonDistrict/MAT_LIGHT_1_emissive.png} uv0 sRGB
