OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Dumpster (CyberPunk) Game Assets" by EXHALE (@design.ruben), CC BY 4.0 -- https://sketchfab.com/3d-models/dumpster-cyberpunk-game-assets-b0d0304c927b450d904163fa43978519
NAME NeonDistrict_sf42_RootNode
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.6
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/RootNode_baseColor.png} uv0 sRGB
TEX normal {path:Textures/NeonDistrict/RootNode_normal.jpg} uv0 normal
