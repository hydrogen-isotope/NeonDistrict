OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Asian Mini Truck" by Evan Hiltz (@evan.hiltz), CC BY 4.0 -- https://sketchfab.com/3d-models/asian-mini-truck-b5a40b838b414d248db2d2fab6a2bb56
NAME NeonDistrict_sf19_blinn1SG
SHADER standard
BLEND translucent
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/Image_6-2.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/Image_7-2.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/Image_8-1.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/Image_7-2.png} uv0 linear
