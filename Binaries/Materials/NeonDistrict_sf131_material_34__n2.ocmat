OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Modular Slums" by AlexFerrart3D (@alexferrart3D), CC BY 4.0 -- https://sketchfab.com/3d-models/modular-slums-e2b6f532e1fe4f7280890971d78183f4
NAME NeonDistrict_sf131_material_34__n2
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.5
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.0096 = about 320 cd/m2:
# night windows: rooms painted into the facade texture, about 1,000 cd/m2 at a full-white texel.
PARAM emissiveFactor 0.0096 0.005568 0.002496
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/material_34_baseColor.jpg} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/material_34_metallicRoughness.png} uv0 linear
TEX occlusion {path:Textures/NeonDistrict/material_34_metallicRoughness.png} uv0 linear
TEX emissive {path:Textures/NeonDistrict/sf131_material_34_i.png} uv0 sRGB
