OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Kiri '86 - Low poly model" by Daniel Zhabotinsky (@DanielZhabotinsky), CC BY 4.0 -- https://sketchfab.com/3d-models/kiri-86-low-poly-model-5c17c582ef9549798f694b660feea42a
NAME NeonDistrict_sf21_kiri86_Bodymat
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0.633459 0.0914359 0.156102 1
PARAM metallicFactor 1
PARAM roughnessFactor 0.157595
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX metalRough {path:Textures/NeonDistrict/Image_0-4.png} uv0 linear
TEX occlusion {path:Textures/NeonDistrict/Image_0-4.png} uv0 linear
