OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: Poly Haven (CC0) or generated for this level
NAME NeonDistrict_pcgm_trim
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0.3
PARAM roughnessFactor 0.6
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.028 = about 930 cd/m2:
# procedural building lit windows, about 930 cd/m2 at a full-white texel.
PARAM emissiveFactor 0.028 0.028 0.028
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/trim.png} uv0 sRGB
TEX emissive {path:Textures/NeonDistrict/trim_e.png} uv0 sRGB
