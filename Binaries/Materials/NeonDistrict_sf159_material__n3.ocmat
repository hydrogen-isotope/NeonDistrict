OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Cyberpunk Shoe Store House" by Bjarne Stokhof (@stokhuis), CC BY 4.0 -- https://sketchfab.com/3d-models/cyberpunk-shoe-store-house-df4a281c365d4be7a11599b2ec22a83a
NAME NeonDistrict_sf159_material__n3
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.03 = about 1,000 cd/m2:
# night windows: rooms painted into the facade texture, about 1,000 cd/m2 at a full-white texel.
PARAM emissiveFactor 0.03 0.03 0.03
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf159_material_b.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/material_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/material_normal.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/material_metallicRoughness.png} uv0 linear
TEX emissive {path:Textures/NeonDistrict/sf157_Building_1_e3.png} uv0 sRGB
