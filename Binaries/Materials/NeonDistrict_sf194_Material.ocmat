OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Sci-Fi Buildings Pack" by golukumar (@mortalityrexotable), CC BY 4.0 -- https://sketchfab.com/3d-models/sci-fi-buildings-pack-cc74d81f4e0e4db3acf6f3433c678250
NAME NeonDistrict_sf194_Material
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/material_baseColor.jpg} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/Material_metallicRoughness-1.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/Material_normal-1.png} uv0 normal
