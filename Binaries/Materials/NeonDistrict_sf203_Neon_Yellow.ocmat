OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Cyberpunk Building" by nicolasodorizi (@nicolasodorizi), CC BY 4.0 -- https://sketchfab.com/3d-models/cyberpunk-building-ea47fe50149d42298b19a839538737d4
NAME NeonDistrict_sf203_Neon_Yellow
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.08 = about 2,670 cd/m2:
# 'coffee' sign text and vertical OPEN neon (emissive colour is cyan 0.03,1,0.86).
PARAM emissiveFactor 0.002266 0.08 0.06889
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
