OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Modular Lowpoly Sci-Fi Building" by pixelgrapher (@pixelgrapher), CC BY 4.0 -- https://sketchfab.com/3d-models/modular-lowpoly-sci-fi-building-814cf55baaeb4931b83a74ebdef9e4a2
NAME NeonDistrict_sf202_wallMAT
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.901888
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/wallMAT_baseColor.png} uv0 sRGB
