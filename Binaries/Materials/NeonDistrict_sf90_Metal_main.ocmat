OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Futuristic building" by Oleksandr Zymohliad (@oleksandr_zymohliad), CC BY 4.0 -- https://sketchfab.com/3d-models/futuristic-building-8cb99bb8e540450eb11c2bddeac1343a
NAME NeonDistrict_sf90_Metal_main
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0.377925 0.377925 0.377925 1
PARAM metallicFactor 1
PARAM roughnessFactor 0.0836509
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/Metal_main_baseColor.jpg} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/Metal_main_metallicRoughness.png} uv0 linear
