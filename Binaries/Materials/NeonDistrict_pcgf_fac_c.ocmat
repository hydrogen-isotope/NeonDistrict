OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: Poly Haven (CC0) or generated for this level
NAME NeonDistrict_pcgf_fac_c
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0.1
PARAM roughnessFactor 0.5
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.03 = about 1,000 cd/m2:
# procedural futuristic facade atlas: painted night rooms (texel 1.0 = bare lamp or TV), shop signs and neon, about 1,000 cd/m2 at a full-white texel.
PARAM emissiveFactor 0.03 0.03 0.03
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/fac_C.png} uv0 sRGB
TEX emissive {path:Textures/NeonDistrict/fac_C_e.png} uv0 sRGB
