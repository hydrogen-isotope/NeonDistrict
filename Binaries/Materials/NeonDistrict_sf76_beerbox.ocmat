OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Alley Asset" by KeyChqn (@KeyChqn), CC BY 4.0 -- https://sketchfab.com/3d-models/alley-asset-aeaa522bdcf347dc9994d559213dd42e
NAME NeonDistrict_sf76_beerbox
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/_007__0_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/_007__0_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/_007__0_normal.png} uv0 normal
