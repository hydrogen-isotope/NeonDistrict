OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Japanese parking machine" by AndreiVNK, CC BY 4.0 -- https://sketchfab.com/3d-models/japanese-parking-machine-a93161d5bafb4d83a73c766aadb97416
NAME NeonDistrict_sf31_lambert1
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.08 = about 2,670 cd/m2:
# yellow LED digit/status displays on the head front panel (emissive map lights only ~374 px inside the display UV area, colour ~(224,217,84)); everything else black.
PARAM emissiveFactor 0.08 0.08 0.08
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf31_lambert1_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf31_lambert1_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf31_lambert1_normal.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/sf31_lambert1_metallicRoughness.png} uv0 linear
TEX emissive {path:Textures/NeonDistrict/sf31_lambert1_emissive.png} uv0 sRGB
