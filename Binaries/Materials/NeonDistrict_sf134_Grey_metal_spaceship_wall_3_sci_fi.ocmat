OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Futuristic background buildings kit" by Jungle Jim (@jungle_jim), CC BY 4.0 -- https://sketchfab.com/3d-models/futuristic-background-buildings-kit-2d5727126bc441ce88dba3a891857876
NAME NeonDistrict_sf134_Grey_metal_spaceship_wall_3_sci_fi
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.91591
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf134_Grey_metal_spaceship_wall_3_sci_fi_diffuse.png} uv0 sRGB
TEX normal {path:Textures/NeonDistrict/sf134_Grey_metal_spaceship_wall_3_sci_fi_normal.png} uv0 normal
