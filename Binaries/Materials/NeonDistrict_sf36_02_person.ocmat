OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "WIP - Lowpoly People - 2" by Loic Norgeot (@norgeotloic), CC BY 4.0 -- https://sketchfab.com/3d-models/wip-lowpoly-people-2-4cf6f452719c4363bab5faddbc221391
NAME NeonDistrict_sf36_02_person
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/02_person_baseColor.jpg} uv0 sRGB
TEX normal {path:Textures/NeonDistrict/02_person_normal.jpg} uv0 normal
