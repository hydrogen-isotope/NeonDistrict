OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Generic civil service vehicles pack" by Comrade1280, CC BY 4.0 -- https://sketchfab.com/3d-models/generic-civil-service-vehicles-pack-8ff2a13f30914932a70c7950cfa58465
NAME NeonDistrict_sf23_cervicetruck_tex
SHADER standard
BLEND opaque
CULL back
FLAGS twosided=0 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/Image_26-1.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/Image_27-2.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/Image_28-2.png} uv0 normal
