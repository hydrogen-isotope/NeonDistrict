OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "GAMMA TOWER" by Portal.Studio (@Portal.Studio), CC BY 4.0 -- https://sketchfab.com/3d-models/gamma-tower-e5313bbb8c5c47328e3b1405f25d5139
NAME NeonDistrict_sf167_MAT_LIGHT_2
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0 0 0 1
PARAM metallicFactor 0
PARAM roughnessFactor 0
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.03 = about 1,000 cd/m2:
# inner light core (Object_4), buried inside the greebles, barely visible.
PARAM emissiveFactor 0.03 0.03 0.03
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX emissive {path:Textures/NeonDistrict/MAT_LIGHT_2_emissive-1.png} uv0 sRGB
