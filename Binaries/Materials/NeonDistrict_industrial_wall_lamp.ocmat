OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: Poly Haven (CC0) or generated for this level
NAME NeonDistrict_industrial_wall_lamp
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 1
# No glow: the source carried an emissive factor with no (or an all-black) emissive map.
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/industrial_wall_lamp_diff_1k.jpg} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/industrial_wall_lamp_arm_1k.jpg} uv0 linear
TEX normal {path:Textures/NeonDistrict/industrial_wall_lamp_nor_gl_1k.jpg} uv0 normal
TEX emissive {path:Textures/NeonDistrict/industrial_wall_lamp_emissive_1k.jpg} uv0 sRGB
