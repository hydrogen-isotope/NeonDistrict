OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "LOW POLY - ASIAN TOWER BLOCK" by Colin.Greenall, CC BY 4.0 -- https://sketchfab.com/3d-models/low-poly-asian-tower-block-694adf5094fa41f99a245ed822293f47
NAME NeonDistrict_sf05_standardSurface1
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
# Not metal: its metal/rough map marks the panes metal 1 / rough 0, a black mirror.
PARAM metallicFactor 0
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf05_Image_0.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf05_Image_1.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf05_Image_2.png} uv0 normal
