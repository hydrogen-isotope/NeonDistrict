OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Building pack" by Pasha (@Pasha.), CC BY 4.0 -- https://sketchfab.com/3d-models/building-pack-ecec5070c3564d429062f346355634c7
NAME NeonDistrict_sf120_Fencing_Railing_Metal
SHADER standard
# Cut-out, not blended: the alpha is a mask (windows, laundry, grilles); blending sorts badly and
# is invisible to GI.
BLEND masked 0.5
CULL back
FLAGS twosided=0 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 0.6
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/Fencing_Railing_Metal_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/Fencing_Railing_Metal_metallicRoughness.png} uv0 linear
