OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Low Cyberpunk Building" by JackSpector_Ink (@Sp3ctor_Ink), CC BY 4.0 -- https://sketchfab.com/3d-models/low-cyberpunk-building-c344904c020742d78a6967ce04faae95
NAME NeonDistrict_sf219_emission
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0 0 0 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.08 = about 2,670 cd/m2:
# magenta neon (emission 1,0,0.9) strips, probably along the slab edges.
PARAM emissiveFactor 0.08 0 0.07161
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
