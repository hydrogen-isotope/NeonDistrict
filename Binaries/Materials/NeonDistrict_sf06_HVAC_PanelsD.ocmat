OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Rooftop Ventilation Modular Kit" by D3D (Darko3DArt), CC BY 4.0 -- https://sketchfab.com/3d-models/rooftop-ventilation-modular-kit-53535fc3005741758c35a4b7227aaff5
NAME NeonDistrict_sf06_HVAC_PanelsD
SHADER standard
BLEND opaque
CULL back
FLAGS twosided=0 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf06_Image_13.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf06_Image_14.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf06_Image_15.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/sf06_Image_14.png} uv0 linear
