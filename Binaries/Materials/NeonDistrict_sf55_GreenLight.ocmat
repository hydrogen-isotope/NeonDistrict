OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Fisher boat" by Batuhan13 (@Batuhan13), CC BY 4.0 -- https://sketchfab.com/3d-models/fisher-boat-385b039e95754dca8d8c045ed0c515cf
NAME NeonDistrict_sf55_GreenLight
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0.256634 0.903545 0.225979 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.856566
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.1 = about 3,330 cd/m2:
# green navigation lamp above the wheelhouse roof front (glTF emissive factor (0.04, 1, 0), no strength extension). It sits at +X, which is the PORT side when the bow is -Y; convention is green = starboard = -X here, so swap the two lamps' colours if you want it correct. Tiny 8 cm lens..
PARAM emissiveFactor 0.003782 0.1 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX normal {path:Textures/NeonDistrict/GreenLight_normal.png} uv0 normal
