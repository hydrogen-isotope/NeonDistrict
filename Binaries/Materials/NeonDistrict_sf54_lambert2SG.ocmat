OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Traditional Bangladeshi Boat" by Zamir Uddin (@xamir), CC BY 4.0 -- https://sketchfab.com/3d-models/traditional-bangladeshi-boat-45ab977c53aa44c3b9c81052dcf19b57
NAME NeonDistrict_sf54_lambert2SG
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/lambert2SG_baseColor.jpg} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/lambert2SG_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/lambert2SG_normal.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/lambert2SG_metallicRoughness.png} uv0 linear
