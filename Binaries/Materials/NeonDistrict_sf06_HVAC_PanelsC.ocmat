OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Rooftop Ventilation Modular Kit" by D3D (Darko3DArt), CC BY 4.0 -- https://sketchfab.com/3d-models/rooftop-ventilation-modular-kit-53535fc3005741758c35a4b7227aaff5
NAME NeonDistrict_sf06_HVAC_PanelsC
SHADER standard
BLEND opaque
CULL back
FLAGS twosided=0 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.05 = about 1,670 cd/m2:
# small red status LEDs / indicator lamps (control-panel lamp row on unit A, indicator clusters on units B and C); emissive map is about 99.7% black, brightest texel 0.48, and the glTF adds emissiveStrength 2.31.
PARAM emissiveFactor 0.05 0.05 0.05
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf06_Image_9.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf06_Image_10.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf06_Image_12.png} uv0 normal
TEX occlusion {path:Textures/NeonDistrict/sf06_Image_10.png} uv0 linear
TEX emissive {path:Textures/NeonDistrict/sf06_Image_11.png} uv0 sRGB
