OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: Poly Haven (CC0) or generated for this level
NAME NeonDistrict_nd_ground_rock
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=1

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
# World-aligned tiling: one texture repeat per 1600 cm, whatever the mesh UVs say.
PARAM uvTiling 1600

TEX baseColor {path:Textures/NeonDistrict/rocky_terrain_02_diff_2k.jpg} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/ph_rocky_terrain_02_orm.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/rocky_terrain_02_nor_gl_2k.jpg} uv0 normal
