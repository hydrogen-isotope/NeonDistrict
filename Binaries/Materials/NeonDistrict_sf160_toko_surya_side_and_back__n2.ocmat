OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Old Indonesian Shop Buildings" by Frid.blend (@Fridqeir), CC BY 4.0 -- https://sketchfab.com/3d-models/old-indonesian-shop-buildings-ea79a679c6794b46a8e6ba86751317c2
NAME NeonDistrict_sf160_toko_surya_side_and_back__n2
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.821115
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.03 = about 1,000 cd/m2:
# night windows: rooms painted into the facade texture, about 1,000 cd/m2 at a full-white texel.
PARAM emissiveFactor 0.03 0.03 0.03
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf160_toko_surya_side_and_back_baseColor.png} uv0 sRGB
TEX emissive {path:Textures/NeonDistrict/sf160_toko_surya_side_and_back_e2.png} uv0 sRGB
