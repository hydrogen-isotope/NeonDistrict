OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Flying futuristic train with uncleaned graffiti" by @blue.blender.print (@arobaco), CC BY 4.0 -- https://sketchfab.com/3d-models/flying-futuristic-train-with-uncleaned-graffiti-deb521c6353844449422aacc12790a3f
NAME NeonDistrict_sf65_SciFiTram
SHADER standard
# Opaque, not blended: its alpha is 1 almost everywhere, and blended emitters are invisible to GI.
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.15 = about 5,000 cd/m2:
# destination board, running lights and window glow from the emissive map.
PARAM emissiveFactor 0.15 0.15 0.15
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/sf65_SciFiTram_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/sf65_SciFiTram_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/sf65_SciFiTram_normal.png} uv0 normal
TEX emissive {path:Textures/NeonDistrict/sf65_SciFiTram_emissive.png} uv0 sRGB
