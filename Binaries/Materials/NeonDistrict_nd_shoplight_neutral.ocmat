OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: Poly Haven (CC0) or generated for this level
NAME NeonDistrict_nd_shoplight_neutral
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0.962809 0.92879 0.872087 1
PARAM metallicFactor 0
PARAM roughnessFactor 0.35
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.3 = about 10,000 cd/m2:
# 4000 K shopfront tube, about 10,000 cd/m2.
PARAM emissiveFactor 0.3 0.219 0.153
# THE LIGHT IT CASTS: every draw with this material is a small sphere light (at most 32 lit per
# frame); 0.408 multiplies what its own glow over its size physically casts.
PARAM lightIntensity 0.408
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
