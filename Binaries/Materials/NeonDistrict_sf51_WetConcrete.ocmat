OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Warehouse FBX Model Free" by Nicholas-3D (@Nicholas01), CC BY 4.0 -- https://sketchfab.com/3d-models/warehouse-fbx-model-free-daa7fd3ff88945298d00045ca40a4c03
NAME NeonDistrict_sf51_WetConcrete
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 1 1 1 1
PARAM metallicFactor 0.646617
PARAM roughnessFactor 1
PARAM emissiveFactor 0 0 0
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200

TEX baseColor {path:Textures/NeonDistrict/WetConcrete_baseColor.png} uv0 sRGB
TEX metalRough {path:Textures/NeonDistrict/WetConcrete_metallicRoughness.png} uv0 linear
TEX normal {path:Textures/NeonDistrict/WetConcrete_normal.png} uv0 normal
