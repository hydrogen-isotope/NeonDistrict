OCMAT 1
# Written by the Aver Engine editor.
# NeonDistrict: "Chinese Food Stall in London" by Pukka Films (@pukkafilms), CC BY 4.0 -- https://sketchfab.com/3d-models/chinese-food-stall-in-london-4c860ac992c74547b3dbcb802b52ea98
NAME NeonDistrict_sf24_Material_002
SHADER standard
BLEND opaque
CULL none
FLAGS twosided=1 castshadow=1 worlduv=0

PARAM baseColorFactor 0 0 0 1
PARAM metallicFactor 1
PARAM roughnessFactor 1
# Emissive in engine units: 1 = a white wall in full sun, about 33,000 cd/m2. Peak 0.02 = about 670 cd/m2:
# tiny indicator LED (5 x 19 x 16 mm) on the switch box of the left front post at z about 2.0 m; glTF gives emissive factor 1 x KHR strength 10, which would be blinding if taken literally.
PARAM emissiveFactor 0.02 0.02 0.02
PARAM normalScale 1
PARAM occlusionStrength 1
PARAM reflectance 0.04
PARAM f90 1
PARAM ior 1.5
PARAM transmission 0
PARAM uvTiling 200
